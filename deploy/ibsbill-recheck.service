[Unit]
Description=IBS MoMo gateway: settle payments still pending with MTN
After=network-online.target

[Service]
Type=oneshot
# Adjust the user and the paths to match your server.
User=ibsbill
WorkingDirectory=/srv/ibsbill
ExecStart=/srv/ibsbill/venv/bin/python manage.py recheck_pending --older-than 10 --limit 200
